{
  "name": "bot-max-assistant",
  "version": "0.1.0",
  "description": "Персональный ассистент для мессенджера Max",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca tsx watch src/index.ts",
    "build": "tsc",
    "start": "node --use-system-ca dist/src/index.js",
    "subscribe": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/subscribe.ts"
  },
  "dependencies": {
    "@maxhub/max-bot-api": "latest",
    "better-sqlite3": "^12.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "music-metadata": "^11.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5"
  },
  "engines": {
    "node": ">=20"
  }
}
