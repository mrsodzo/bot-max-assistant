# Токен бота Max (обязательный). Получить можно в профиле бота / настройках API.
BOT_TOKEN=your_max_bot_token_here

# OpenAI-совместимый API (используется в шаге обработки сообщений ИИ).
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://apihub.agnes-ai.com/v1/chat/completions
OPENAI_MODEL=agnes-2.0-flash
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# Публичный HTTPS-URL, по которому Max будет слать вебхуки (должен заканчиваться на /webhook).
WEBHOOK_URL=https://your-tunnel.example.com/webhook

# Секретный ключ для проверки подлинности вебхук-запросов от Max (заголовок X-Max-Bot-Api-Secret).
WEBHOOK_SECRET=your_random_secret_here

# Порт локального Express-сервера (по умолчанию 3000).
PORT=3000

# Путь к файлу SQLite-базы (по умолчанию ./data.db).
DB_PATH=./data.db

# URL локального сервиса GigaAM-транскрибации (по умолчанию http://localhost:8001).
# Используется, когда TRANSCRIBER_BACKEND=local.
TRANSCRIBER_URL=http://localhost:8001

# Бекенд транскрибации: "local" (GigaAM через FastAPI), "hf" (Hugging Face Inference API) или "groq" (Whisper через Groq).
TRANSCRIBER_BACKEND=local

# Hugging Face API-ключ — нужен, когда TRANSCRIBER_BACKEND=hf.
HF_API_KEY=your_hf_api_key_here
# Модель ASR для HF Inference API (стандартная ASR-модель, например openai/whisper-base).
# GigaAM не поддерживается serverless API (trust_remote_code), используйте бекенд "local" для неё.
HF_MODEL=openai/whisper-base

# Groq API-ключ — нужен, когда TRANSCRIBER_BACKEND=groq.
GROQ_API_KEY=your_groq_api_key_here
# Модель Whisper в Groq (whisper-large-v3 по умолчанию).
GROQ_MODEL=whisper-large-v3
