# Токен бота Max (обязательный). Получить можно в профиле бота / настройках API.
BOT_TOKEN=your_max_bot_token_here

# API-ключ Anthropic Claude (используется в шаге обработки сообщений ИИ).
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Публичный HTTPS-URL, по которому Max будет слать вебхуки (должен заканчиваться на /webhook).
WEBHOOK_URL=https://your-tunnel.example.com/webhook

# Секретный ключ для проверки подлинности вебхук-запросов от Max (заголовок X-Max-Bot-Api-Secret).
WEBHOOK_SECRET=your_random_secret_here

# Порт локального Express-сервера (по умолчанию 3000).
PORT=3000

# Путь к файлу SQLite-базы (по умолчанию ./data.db).
DB_PATH=./data.db

# URL локального сервиса GigaAM-транскрибации (по умолчанию http://localhost:8001).
TRANSCRIBER_URL=http://localhost:8001
